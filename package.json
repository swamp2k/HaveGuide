{
  "name": "have-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typegen && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typegen": "wrangler types worker-configuration.d.ts",
    "typecheck": "npm run typegen && tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "native:add:android": "npm run build && npx cap add android",
    "native:sync:android": "npm run build && npx cap sync android",
    "native:open:android": "npx cap open android",
    "native:run:android": "npm run native:sync:android && npx cap run android",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2",
    "@have-guide/garden-scan": "file:native/garden-scan",
    "hono": "^4.9.2",
    "maplibre-gl": "^5.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@cloudflare/vite-plugin": "^1.12.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
